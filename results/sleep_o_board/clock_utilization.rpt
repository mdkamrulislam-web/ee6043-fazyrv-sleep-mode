# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y17 [get_cells u_bufg]
set_property LOC BUFGCTRL_X0Y16 [get_cells u_bufgce]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X1Y124 [get_ports sysclk]

# Clock net "clk_free" driven by instance "u_bufg" located at site "BUFGCTRL_X0Y17"
#startgroup
create_pblock {CLKAG_clk_free}
add_cells_to_pblock [get_pblocks  {CLKAG_clk_free}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="clk_free"}]]]
resize_pblock [get_pblocks {CLKAG_clk_free}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0}
#endgroup

# Clock net "clk_cpu" driven by instance "u_bufgce" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_clk_cpu}
add_cells_to_pblock [get_pblocks  {CLKAG_clk_cpu}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="clk_cpu"}]]]
resize_pblock [get_pblocks {CLKAG_clk_cpu}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0}
#endgroup
