<mxfile host="app.diagrams.net"><diagram name="Page-1" id="p1"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1070" pageHeight="260"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;1. Program&lt;/b&gt;&lt;br&gt;fw/bench.c (workload)&lt;br&gt;RISC-V GCC&lt;br&gt;-&amp;gt; firmware.mem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff6e8;strokeColor=#9a5b00;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20.0" y="60.0" width="150.0" height="95.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;2. Vivado build&lt;/b&gt;&lt;br&gt;synthesis, place, route&lt;br&gt;program inside BRAM&lt;br&gt;(scripts/build.tcl)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#1f3b73;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="197.0" y="60.0" width="150.0" height="95.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;3. Netlist&lt;/b&gt;&lt;br&gt;write_verilog&lt;br&gt;-mode funcsim&lt;br&gt;of the routed design" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#1f3b73;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="374.0" y="60.0" width="150.0" height="95.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;4. Simulation&lt;/b&gt;&lt;br&gt;xsim + tb_power.sv&lt;br&gt;3.1 ms = one full pass&lt;br&gt;log_saif on all nets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eefaf0;strokeColor=#1d6b33;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="551.0" y="60.0" width="150.0" height="95.0" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;5. Activity file&lt;/b&gt;&lt;br&gt;activity.saif&lt;br&gt;how often every&lt;br&gt;net switches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eefaf0;strokeColor=#1d6b33;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="728.0" y="60.0" width="150.0" height="95.0" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;6. Power report&lt;/b&gt;&lt;br&gt;read_saif, report_power&lt;br&gt;by type and by block&lt;br&gt;confidence: High" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf5fd;strokeColor=#7a2e8e;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="905.0" y="60.0" width="150.0" height="95.0" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="Same program, same clock (125 MHz) and same simulation time for both versions, so the two results can be compared directly." style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="185" width="1000" height="20" as="geometry"/></mxCell><mxCell id="c15" value="Without an activity file Vivado assumes a fixed switching rate for every net (confidence Medium)." style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="205" width="1000" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>