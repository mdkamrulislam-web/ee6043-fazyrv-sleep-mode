<mxfile host="app.diagrams.net"><diagram name="Page-1" id="p1"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="450"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;sysclk&lt;/b&gt;&lt;br&gt;125 MHz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="145" width="80" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;BUFG&lt;/b&gt;&lt;br&gt;free clock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#1f3b73;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="90" width="110" height="55" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;BUFGCE&lt;/b&gt;&lt;br&gt;gated clock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeeee;strokeColor=#a12a2a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="235" width="110" height="55" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;sleep_ctrl (free clock)&lt;/b&gt;&lt;br&gt;register 0x2000_0000&lt;br&gt;write N: sleep N cycles&lt;br&gt;32-bit down counter&lt;br&gt;clk_en = not sleeping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eefaf0;strokeColor=#1d6b33;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="500" y="60" width="260" height="125" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;fsoc_sleep (gated clock)&lt;/b&gt;&lt;br&gt;FazyRV core&lt;br&gt;program RAM + register-file RAM&lt;br&gt;GPIO&lt;br&gt;bus slave 0x2xxx_xxxx&lt;br&gt;frozen while asleep" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf5fd;strokeColor=#7a2e8e;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="500" y="235" width="260" height="165" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="free clock" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="clk_cpu" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#a12a2a;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="clk_en" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2e8b57;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="store N / ack" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="1. The program stores N; the store finishes on that clock edge.&lt;br&gt;2. sleep_ctrl stops clk_cpu (BUFGCE).&lt;br&gt;3. After N cycles the clock returns." style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="460" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>